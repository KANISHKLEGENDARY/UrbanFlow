# ─────────────────────────────────────────────
# UrbanFlow Frontend — Development Dockerfile
# ─────────────────────────────────────────────

FROM node:20-alpine

WORKDIR /app

# Copy package files and install dependencies
COPY package.json package-lock.json* ./
RUN npm install

# Copy source code
COPY . .

# Expose Vite dev server port
EXPOSE 3000

# Run Vite dev server with host and port configuration
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "3000"]
