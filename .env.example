# UrbanFlow — Environment Variables
# Copy to .env and adjust for your environment.
# These are loaded by docker-compose and python-dotenv.

# ─── Database ────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=urbanflow
# Local dev (API run directly on host):
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/urbanflow
# Docker Compose (API run inside container — use host "db"):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/urbanflow
DATABASE_ENABLED=true

# ─── JWT Authentication ─────────────────────
# IMPORTANT: Change SECRET_KEY in production!
SECRET_KEY=urbanflow-dev-secret-change-in-production
AUTH_ENABLED=true

# ─── API ─────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# ─── Frontend ────────────────────────────────
VITE_API_BASE=http://localhost:8000

# ─── Monitoring ──────────────────────────────
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=urbanflow
